# ==============================================================================
# Google Earth Engine (GEE) Configuration
# ==============================================================================
# 1. Your Google Cloud Project ID with Earth Engine API enabled:
EE_PROJECT_ID=your_gcp_project_id

# 2. Optional: Path to Service Account JSON key (defaults to credentials.json if present):
EE_SERVICE_ACCOUNT_KEY=credentials.json

# ==============================================================================
# Roboflow Configuration
# ==============================================================================
# 1. Roboflow Private API Key (Settings > Workspaces > Roboflow API):
ROBOFLOW_API_KEY=your_private_api_key_here

# 2. Workspace ID (e.g., my-workspace-slug):
ROBOFLOW_WORKSPACE=your_workspace_id

# 3. Project / Dataset ID (e.g., satellite-detection-xyz):
ROBOFLOW_PROJECT=your_project_id
