# ==============================================================================
# Google Earth Engine (GEE) Configuration
# ==============================================================================
# Google Cloud Project ID with Earth Engine API enabled:
EE_PROJECT_ID=

# ==============================================================================
# Roboflow Configuration (Annotation Batch Uploads)
# ==============================================================================
# 1. Roboflow Private API Key (Roboflow > Settings > Workspaces > Roboflow API):
ROBOFLOW_API_KEY=

# 2. Workspace ID (e.g., my-workspace-slug):
ROBOFLOW_WORKSPACE=

# 3. Project / Dataset ID (e.g., satellite-detection-xyz):
ROBOFLOW_PROJECT=
